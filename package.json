{
  "name": "functions",
  "scripts": {
    "deploy": "firebase deploy --only functions:webhook",
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:critical": "vitest run critical-path.test.ts",
    "test:api": "RUN_API_TESTS=true vitest run critical-path.test.ts",
    "test:integration": "RUN_INTEGRATION_TESTS=true vitest run",
    "test:all": "RUN_API_TESTS=true RUN_INTEGRATION_TESTS=true vitest run"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@firebase/app": "^0.16.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^11.0.0",
    "openai": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/ui": "^4.1.10",
    "c8": "^12.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "private": true,
  "overrides": {
    "@tootallnate/once": "3.0.1"
  }
}
